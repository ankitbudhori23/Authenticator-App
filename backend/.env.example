PORT=5000
NODE_ENV=development

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Supported dialects: mysql | postgres | sqlite | mssql
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=app_db
DB_USER=root
DB_PASSWORD=

# Only used for sqlite dialect
DB_STORAGE=./data/dev.sqlite

# Set to true to see raw SQL in the console
DB_LOGGING=false

DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE=10000
DB_POOL_ACQUIRE=30000
